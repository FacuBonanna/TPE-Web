package views

import (
	"fmt"

	sqlc "TPE/db/sqlc"
)

var formCrearTratamiento = Formulario{
	Accion:   "/tratamiento",
	Metodo:   "POST",
	Etiqueta: "Crear Tratamiento",
	Campos: []Campo{
		Texto("nombre", "Nombre"),
		Texto("descripcion_corta", "Descripción"),
		Numero("costo", "Costo"),
	},
}

var formBuscarTratamiento = Formulario{
	Accion:   "/search-tratamiento",
	Etiqueta: "Buscar Tratamiento",
	Campos:   []Campo{Numero("tratamiento_id", "ID del tratamiento")},
}

var columnasTratamientos = []string{"Id", "Nombre", "Descripcion", "Costo"}

// celdasTratamiento mapea un Tratamiento a las celdas de su fila (mismo orden que columnasTratamientos).
func celdasTratamiento(t sqlc.Tratamiento) []string {
	return []string{
		fmt.Sprint(t.ID),
		t.Nombre,
		t.DescripcionCorta,
		fmt.Sprint(t.Costo),
	}
}

templ Tratamientos(tratamientos []sqlc.Tratamiento) {
	@Seccion("tratamientos", "Tratamientos","Mostrar tratamientos","/tratamiento") {
		@Bloque("Crear Tratamiento", formCrearTratamiento)
		@Bloque("Buscar Tratamiento", formBuscarTratamiento)
		@Tabla("tablaTratamientos", "cuerpoTablaTratamiento", columnasTratamientos) {
			for _, t := range tratamientos {
				@Fila(celdasTratamiento(t))
			}
		}
	}
}