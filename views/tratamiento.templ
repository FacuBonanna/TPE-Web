package views

import (
	"fmt"

	sqlc "TPE/db/sqlc"
)

var formCrearTratamiento = Formulario{
	Accion:   "/tratamiento",
	Metodo:   "POST",
	Etiqueta: "Crear Tratamiento",
	Campos: []Campo{
		Texto("nombre", "Nombre"),
		Texto("descripcion_corta", "Descripción"),
		Numero("costo", "Costo"),
	},
	HxPost:   "/tratamiento",
	HxTarget: "#tablaTratamientos",
	HxSwap:   "outerHTML",
}

var formBuscarTratamiento = Formulario{
	Accion:   "/search-tratamiento",
	HxGet:    "/search-tratamiento",
	HxTarget: "#tablaTratamientos",
	HxSwap:   "outerHTML",
	Etiqueta: "Buscar Tratamiento",
	Campos:   []Campo{Numero("tratamiento_id", "ID del tratamiento")},
}

var columnasTratamientos = []string{"Id", "Nombre", "Descripcion", "Costo", "Acciones"}

templ FilaTratamiento(t sqlc.Tratamiento) {
	<tr>
		<td>{ fmt.Sprint(t.ID) }</td>
		<td>{ t.Nombre }</td>
		<td>{ t.DescripcionCorta }</td>
		<td>{ fmt.Sprint(t.Costo) }</td>
		<td>
			@BotonActualizar(fmt.Sprintf("/tratamiento/%d/edit", t.ID))
			@BotonBorrar(fmt.Sprintf("/tratamiento/%d", t.ID), "¿Está seguro de que desea eliminar este tratamiento?")
		</td>
	</tr>
}

templ FilaTratamientoEdit(t sqlc.Tratamiento) {
	<tr class="editing">
		<td>{ fmt.Sprint(t.ID) }</td>
		<td><input class="campo" type="text" name="nombre" value={ t.Nombre }/></td>
		<td><input class="campo" type="text" name="descripcion_corta" value={ t.DescripcionCorta }/></td>
		<td><input class="campo" type="number" name="costo" value={ fmt.Sprint(t.Costo) }/></td>
		<td>
			<button
				type="button"
				class="btn btn-actualizar"
				hx-put={ fmt.Sprintf("/tratamiento/%d", t.ID) }
				hx-include="closest tr"
				hx-target="closest tr"
				hx-swap="outerHTML"
			>
				Guardar
			</button>
			<button
				type="button"
				class="btn btn-cancelar"
				hx-get={ fmt.Sprintf("/tratamiento/%d", t.ID) }
				hx-target="closest tr"
				hx-swap="outerHTML"
			>
				Cancelar
			</button>
		</td>
	</tr>
}

templ TablaTratamientos(tratamientos []sqlc.Tratamiento) {
	@Tabla("tablaTratamientos", "cuerpoTablaTratamiento", columnasTratamientos) {
		for _, t := range tratamientos {
			@FilaTratamiento(t)
		}
	}
}

templ Tratamientos(tratamientos []sqlc.Tratamiento) {
	@Seccion("tratamientos", "Tratamientos","Mostrar tratamientos","/tratamiento") {
		@Bloque("Crear Tratamiento", formCrearTratamiento)
		@Bloque("Buscar Tratamiento", formBuscarTratamiento)
		@TablaTratamientos(tratamientos)
	}
}