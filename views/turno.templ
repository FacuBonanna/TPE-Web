package views

import (
	"fmt"
	"time"

	sqlc "TPE/db/sqlc"

)

var formCrearTurno = Formulario{
	Accion:   "/turno",
	Metodo:   "POST",
	Etiqueta: "Crear Turno",
	Campos: []Campo{
		Texto("fecha", "Fecha del turno"),
		Texto("hora", "Hora del turno"),
		Numero("cliente_documento", "Documento del cliente"),
		Numero("tratamiento_id", "ID del tratamiento"),
	},
	HxPost:   "/turno",
	HxTarget: "#tablaTurnos",
	HxSwap:   "outerHTML",
}

var formBuscarTurno = Formulario{
	Accion:   "/search-turno",
	Etiqueta: "Buscar Turno",
	Campos: []Campo{
		Texto("fecha", "Fecha del turno"),
		Texto("hora", "Hora del turno"),
	},
	Metodo: "GET",
    HxGet:    "/search-turno",
    HxTarget: "#cuerpoTablaTurno",
    HxSwap:   "innerHTML",
}

var columnasTurnos = []string{"Fecha", "Hora", "Tratamiento", "Cliente", "Acciones"}

func fechaAString(d time.Time) string {
	return d.Format("02/01/2006")
}																																																						

templ FilaTurno(t sqlc.GetTurnosCompletoRow) {
	<tr>
		<td>{ fechaAString(t.Fecha) }</td>																																																
		<td>{ fmt.Sprint(t.Hora) }</td>																																	
		<td>{ fmt.Sprint(t.NombreTratamiento) }</td>																																																																																																																																				
		<td>{ fmt.Sprint(t.NombreCliente) }</td>
		<td>
			@BotonActualizar(fmt.Sprintf("/turno/%s/%d/edit", t.Fecha.Format("2006-01-02"), t.Hora))
			@BotonBorrar(fmt.Sprintf("/turno/%s/%d", t.Fecha.Format("2006-01-02"), t.Hora), "¿Está seguro de que desea eliminar este turno?")
		</td>																					
	</tr>																																					
}

templ FilaTurnoEdit(t sqlc.GetTurnoRow) {
    <tr class="editing">
        <td>{ fechaAString(t.Fecha) }</td>
		<td>{ fmt.Sprint(t.Hora) }</td>
        <td><input class="campo" type="number" name="tratamiento_id" value={ fmt.Sprint(t.TratamientoID) }/></td>
		<td><input class="campo" type="number" name="cliente_documento" value={ fmt.Sprint(t.ClienteDocumento) }/></td>
        <td>
            <button
                type="button"
                class="btn btn-actualizar"
                hx-put={ fmt.Sprintf("/turno/%s/%d", t.Fecha.Format("2006-01-02") ,t.Hora) }
                hx-include="closest tr"
                hx-target="closest tr"
                hx-swap="outerHTML"
            >
                Guardar
            </button>
            <button
                type="button"
                class="btn btn-cancelar"
                hx-get={ fmt.Sprintf("/turno/%s/%d", t.Fecha.Format("2006-01-02") ,t.Hora) }
                hx-target="closest tr"
                hx-swap="outerHTML"
            >
                Cancelar
            </button>
        </td>
    </tr>
}

templ FilasTurno(turnos []sqlc.GetTurnosCompletoRow){
    for _, t := range turnos {
        @FilaTurno(t)
    }
}

templ TablaTurnos(turnos []sqlc.GetTurnosCompletoRow) {
	@Tabla("tablaTurnos", "cuerpoTablaTurno", columnasTurnos) {
		for _, t := range turnos {
			@FilaTurno(t)
		}
	}
}

templ Turnos(turnos []sqlc.GetTurnosCompletoRow) {
	@Seccion("turnos", "Turno", "Mostrar turnos", "/turno-filas","cuerpoTablaTurno") {
		@Bloque("Crear Turno", formCrearTurno)
		@Bloque("Buscar Turno", formBuscarTurno)
		@TablaTurnos(turnos)
	}
}