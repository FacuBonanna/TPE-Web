package views

import (
	"fmt"

	sqlc "TPE/db/sqlc"

	"github.com/jackc/pgx/v5/pgtype"
)

var formCrearTurno = Formulario{
	Accion:   "/turno",
	Metodo:   "POST",
	Etiqueta: "Crear Turno",
	Campos: []Campo{
		Texto("fecha", "Fecha del turno"),
		Texto("hora", "Hora del turno"),
		Numero("cliente_id", "ID del cliente"),
		Numero("tratamiento_id", "ID del tratamiento"),
	},
}

var formBuscarTurno = Formulario{
	Accion:   "/search-turn",
	Etiqueta: "Buscar Turno",
	Campos: []Campo{
		Texto("date", "Fecha del turno"),
		Texto("time", "Hora del turno"),
	},
}

var columnasTurnos = []string{"Fecha", "Hora", "Tratamiento", "Cliente"}

func fechaAString(d pgtype.Date) string {
	if !d.Valid {
		return ""
	}
	return d.Time.Format("02/01/2006")
}

// celdasTurno mapea un turno a las celdas de su fila (mismo orden que columnasTurnos).
func celdasTurno(t sqlc.Turno) []string {
	return []string{
		fechaAString(t.Fecha),
		fmt.Sprint(t.Hora),
		fmt.Sprint(t.TratamientoID),
		fmt.Sprint(t.ClienteID),
	}
}

templ Turnos(turnos []sqlc.Turno) {
	@Seccion("turnos", "Turno", "Mostrar turnos", "/") {
		@Bloque("Crear Turno", formCrearTurno)
		@Bloque("Buscar Turno", formBuscarTurno)
		@Tabla("tablaTurnos", "cuerpoTablaTurno", columnasTurnos) {
			for _, t := range turnos {
				@Fila(celdasTurno(t))
			}
		}
	}
}