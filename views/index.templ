package views

import sqlc "TPE/db/sqlc"

templ Index(clientes []sqlc.Cliente, tratamientos []sqlc.Tratamiento, turnos []sqlc.Turno, voucher []sqlc.Voucher) {
	@Layout("GLAM Estetica Integral") {
		<div class="contenedor-flex">
			@Clientes(clientes)
			@Tratamientos(tratamientos)
			@Vouchers(voucher)
			@Turnos(turnos)
		</div>
	}
}
