package views

import sqlc "TPE/db/sqlc"

templ Index(clientes []sqlc.Cliente, tratamientos []sqlc.Tratamiento, turnos []sqlc.GetTurnosCompletoRow, voucher []sqlc.GetVouchersRow) {
	@Layout("GLAM Estetica Integral") {
		<div class="contenedor-flex">
			@Turnos(turnos)
			@Clientes(clientes)
			@Tratamientos(tratamientos)
			@Vouchers(voucher)
			<div id="mensajes" class="mensajes" role="alert" aria-live="polite"></div>
		</div>
	}
}
