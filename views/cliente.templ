package views

import (
    "fmt"
    sqlc "TPE/db/sqlc"
)

var formCrearCliente = Formulario{
    Accion:   "/cliente",
    Metodo:   "POST",
    Etiqueta: "Crear Cliente",
    Campos: []Campo{
        Numero("cliente_documento","Documento"),
        Texto("name", "Nombre"),
        Texto("surname", "Apellido"),
        Numero("debt", "Deuda"),
        Numero("phone", "Número de teléfono"),
    },
    HxPost:   "/cliente",
    HxTarget: "#tablaClientes",
    HxSwap:   "outerHTML",
}

var formBuscarCliente = Formulario{
	Accion:   "/search-client",
    Metodo:   "GET",
    Etiqueta: "Buscar Cliente",
    Campos:   []Campo{Numero("cliente_documento", "Documento del cliente")},
}

var columnasClientes = []string{"Documento", "Nombre", "Apellido", "Deuda", "Nro telefono", "Acciones"}

templ FilaCliente(c sqlc.Cliente) {
    <tr>
        <td>{ fmt.Sprint(c.Documento) }</td>
        <td>{ c.Nombre }</td>
        <td>{ c.Apellido }</td>
        <td>{ fmt.Sprint(c.Deuda) }</td>
        <td>{ fmt.Sprint(c.NroTelefono) }</td>
        <td>
            @BotonBorrar(fmt.Sprintf("/cliente/%d", c.Documento), "¿Está seguro de que desea eliminar este cliente?")
        </td>
    </tr>
}

templ TablaClientes(clientes []sqlc.Cliente) {
    @Tabla("tablaClientes", "cuerpoTablaCliente", columnasClientes) {
        for _, c := range clientes {
            @FilaCliente(c)
        }
    }
}

templ Clientes(clientes []sqlc.Cliente) {
    @Seccion("clientes", "Clientes","Mostrar clientes","/cliente") {
        @Bloque("Crear cliente", formCrearCliente)
        @Bloque("Buscar cliente", formBuscarCliente)
        @TablaClientes(clientes)
    }
}