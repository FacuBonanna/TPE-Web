package views

import (
    "fmt"
    sqlc "TPE/db/sqlc"

)

var formCrearCliente = Formulario{
    Accion:   "/cliente",
    Metodo:   "POST",
    Etiqueta: "Crear Cliente",
    Campos: []Campo{
        Numero("cliente_documento","Documento"),
        Texto("name", "Nombre"),
        Texto("surname", "Apellido"),
        Numero("debt", "Deuda"),
        Numero("phone", "Número de teléfono"),
    },
}

var formBuscarCliente = Formulario{
	Accion:   "/search-client",
    Metodo:   "GET",
    Etiqueta: "Buscar Cliente",
    Campos:   []Campo{Numero("cliente_documento", "Documento del cliente")},
}

var columnasClientes = []string{"Documento", "Nombre", "Apellido", "Deuda", "Nro telefono"}

// celdasCliente mapea un Cliente a las celdas de su fila (mismo orden que columnasClientes).
func celdasCliente(c sqlc.Cliente) []string {
    return []string{
        fmt.Sprint(c.Documento),
        c.Nombre,
        c.Apellido,
        fmt.Sprint(c.Deuda),
        fmt.Sprint(c.NroTelefono),
    }
}

templ Clientes(clientes []sqlc.Cliente) {
    @Seccion("clientes", "Clientes","Mostrar clientes","/cliente") {
        @Bloque("Crear cliente", formCrearCliente)
        @Bloque("Buscar cliente", formBuscarCliente)
        @Tabla("tablaClientes", "cuerpoTablaCliente", columnasClientes) {
            for _, c := range clientes {
                @Fila(celdasCliente(c))
            }
        }
    }
}