package views

import (
    "fmt"
    sqlc "TPE/db/sqlc"
)

var formCrearCliente = Formulario{
    Accion:   "/cliente",
    Metodo:   "POST",
    Etiqueta: "Crear Cliente",
    Campos: []Campo{
        Numero("cliente_documento","Documento"),
        Texto("name", "Nombre"),
        Texto("surname", "Apellido"),
        Numero("debt", "Deuda"),
        Numero("phone", "Número de teléfono"),
    },
    HxPost:   "/cliente",
    HxTarget: "#tablaClientes",
    HxSwap:   "outerHTML",
}

var formBuscarCliente = Formulario{
    Accion: "/search-client",
    Metodo: "GET",
    HxGet:    "/search-client",
    HxTarget: "#cuerpoTablaCliente",
    HxSwap:   "innerHTML",
    Etiqueta: "Buscar Cliente",
    Campos:   []Campo{Numero("cliente_documento", "Documento del cliente")},
}

var columnasClientes = []string{"Documento", "Nombre", "Apellido", "Deuda", "Nro telefono", "Acciones"}

templ FilaCliente(c sqlc.Cliente) {
    <tr>
        <td>{ fmt.Sprint(c.Documento) }</td>
        <td>{ c.Nombre }</td>
        <td>{ c.Apellido }</td>
        <td>{ fmt.Sprint(c.Deuda) }</td>
        <td>{ fmt.Sprint(c.NroTelefono) }</td>
        <td>
            @BotonActualizar(fmt.Sprintf("/cliente/%d/edit", c.Documento))
            @BotonBorrar(fmt.Sprintf("/cliente/%d", c.Documento), "¿Está seguro de que desea eliminar este cliente?")
        </td>
    </tr>
}

templ FilaClienteEdit(c sqlc.Cliente) {
    <tr class="editing">
        <td>{ fmt.Sprint(c.Documento) }</td>
        <td><input class="campo" type="text" name="name" value={ c.Nombre }/></td>
        <td><input class="campo" type="text" name="surname" value={ c.Apellido }/></td>
        <td><input class="campo" type="number" name="debt" value={ fmt.Sprint(c.Deuda) }/></td>
        <td><input class="campo" type="number" name="phone" value={ fmt.Sprint(c.NroTelefono) }/></td>
        <td>
            <button
                type="button"
                class="btn btn-actualizar"
                hx-put={ fmt.Sprintf("/cliente/%d", c.Documento) }
                hx-include="closest tr"
                hx-target="closest tr"
                hx-swap="outerHTML"
            >
                Guardar
            </button>
            <button
                type="button"
                class="btn btn-cancelar"
                hx-get={ fmt.Sprintf("/cliente/%d", c.Documento) }
                hx-target="closest tr"
                hx-swap="outerHTML"
            >
                Cancelar
            </button>
        </td>
    </tr>
}

templ FilasClientes(clientes []sqlc.Cliente){
    for _, c := range clientes {
        @FilaCliente(c)
    }
}

templ TablaClientes(clientes []sqlc.Cliente) {
    @Tabla("tablaClientes", "cuerpoTablaCliente", columnasClientes) {
        for _, c := range clientes {
            @FilaCliente(c)
        }
    }
}

templ Clientes(clientes []sqlc.Cliente) {
    @Seccion("clientes", "Clientes","Mostrar clientes","/clientes-filas","cuerpoTablaCliente") {
        @Bloque("Crear cliente", formCrearCliente)
        @Bloque("Buscar cliente", formBuscarCliente)
        @TablaClientes(clientes)
    }
}