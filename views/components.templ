package views

type Campo struct {
	Tipo        string
	Nombre      string
	Placeholder string
}

type Formulario struct {
    ID       string
    Accion   string
    Etiqueta string
    Campos   []Campo
    Metodo   string
    HxPost   string
    HxGet    string
    HxTarget string
    HxSwap   string
}

func metodoDe(f Formulario) string {
	if f.Metodo == "" {
		return "GET"
	}
	return f.Metodo
}

func Texto(nombre, placeholder string) Campo {
	return Campo{Tipo: "text", Nombre: nombre, Placeholder: placeholder}
}

func Numero(nombre, placeholder string) Campo {
	return Campo{Tipo: "number", Nombre: nombre, Placeholder: placeholder}
}

templ Form(f Formulario) {
    <form
        if f.ID != "" {
            id={ f.ID }
        }
        if f.Accion != "" {
            action={ templ.SafeURL(f.Accion) }
            method={ metodoDe(f) }
        }
        if f.HxGet != "" {
            hx-get={ f.HxGet }
        }
        if f.HxPost != "" {
            hx-post={ f.HxPost }
        }
        if f.HxTarget != "" {
            hx-target={ f.HxTarget }
        }
        if f.HxSwap != "" {
            hx-swap={ f.HxSwap }
        }
        if f.HxPost != "" {
            hx-on::after-request="if(event.detail.successful) this.reset()"
        }
    >
        for _, c := range f.Campos {
    <input class="campo" type={ c.Tipo } name={ c.Nombre } placeholder={ c.Placeholder } required/>
}
        <button type="submit" class="btn">{ f.Etiqueta }</button>
    </form>
}

templ Bloque(titulo string, f Formulario) {
	<h3>{ titulo }</h3>
	@Form(f)
}

templ Seccion(id, titulo, etiquetaListar, rutaListado, idCuerpo string) {
    <div id={ id } class="item-flex">
        <h2>
            { titulo }
            @Form(Formulario{
                Accion:   rutaListado,
                Metodo:   "GET",
                Etiqueta: etiquetaListar,
                HxGet:    rutaListado,
                HxTarget: "#" + idCuerpo,
                HxSwap:   "innerHTML",
            })
        </h2>
        { children... }
    </div>
}

templ Tabla(id, idCuerpo string, columnas []string) {
	<table id={ id }>
		<thead>
			<tr>
				for _, col := range columnas {
					<th>{ col }</th>
				}
			</tr>
		</thead>
		<tbody id={ idCuerpo }>
			{ children... }
		</tbody>
	</table>
}

templ Fila(celdas []string) {
	<tr>
		for _, celda := range celdas {
			<td>{ celda }</td>
		}
	</tr>
}

templ BotonBorrar(ruta string, confirmacion string) {
    <button
        type="button"
        class="btn btn-borrar"
        hx-delete={ ruta }
        hx-target="closest tr"
        hx-swap="outerHTML"
        if confirmacion != "" {
            hx-confirm={ confirmacion }
        }
    >
        Borrar
    </button>
}

templ BotonActualizar(ruta string) {
    <button
        type="button"
        class="btn btn-actualizar"
        if ruta != "" {
            hx-get={ ruta }
            hx-target="closest tr"
            hx-swap="outerHTML"
        }
    >
        Actualizar
    </button>
}

templ MensajeError(texto string) {
    <div id="mensajes" class="mensajes" hx-swap-oob="true">
        <div class="mensaje-error">{ texto }</div>
    </div>
}