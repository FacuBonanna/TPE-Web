package views

import (
	"fmt"

	sqlc "TPE/db/sqlc"
)

var formCrearVoucher = Formulario{
	Accion: "/voucher",
	Metodo: "POST",
	Etiqueta: "Crear Voucher",
	Campos: []Campo{
		Numero("regalador_documento", "Documento de quien regala"),
		Numero("tratamiento_id", "ID del tratamiento"),
		Numero("cliente_documento", "Documento de quien recibe"),
	},
	HxPost:   "/voucher",
	HxTarget: "#tablaVouchers",
	HxSwap:   "outerHTML",
}

var formBuscarVoucher = Formulario{
	Accion:   "/search-voucher",
	Etiqueta: "Buscar Voucher",
	Campos:   []Campo{Numero("voucher_id", "ID del voucher")},
    Metodo: "GET",
    HxGet:    "/search-voucher",
    HxTarget: "#cuerpoTablaVoucher",
    HxSwap:   "innerHTML",
}


var columnasVouchers = []string{"Id", "De", "Para", "Tratamiento", "Acciones"}

templ FilaVoucher(v sqlc.GetVouchersRow) {
	<tr>
		<td>{ fmt.Sprint(v.IDVoucher) }</td>
		<td>{ fmt.Sprint(v.Regalador) }</td>
		<td>{ fmt.Sprint(v.Cliente) }</td>
		<td>{ fmt.Sprint(v.Tratamiento) }</td>
		<td>
			@BotonActualizar(fmt.Sprintf("/voucher/%d/edit", v.IDVoucher))
			@BotonBorrar(fmt.Sprintf("/voucher/%d", v.IDVoucher), "¿Está seguro de que desea eliminar este voucher?")
		</td>
	</tr>
}

templ FilaVoucherEdit(v sqlc.Voucher) {
    <tr class="editing">
        <td>{ fmt.Sprint(v.IDVoucher) }</td>
        <td><input class="campo" type="number" name="regalador_documento" value={ fmt.Sprint(v.RegaladorDocumento) }/></td>
        <td><input class="campo" type="number" name="cliente_documento" value={ fmt.Sprint(v.ClienteDocumento) }/></td>
		<td><input class="campo" type="number" name="tratamiento_id" value={ fmt.Sprint(v.TratamientoID) }/></td>
        <td>
            <button
                type="button"
                class="btn btn-actualizar"
                hx-put={ fmt.Sprintf("/voucher/%d", v.IDVoucher) }
                hx-include="closest tr"
                hx-target="closest tr"
                hx-swap="outerHTML"
            >
                Guardar
            </button>
            <button
                type="button"
                class="btn btn-cancelar"
                hx-get={ fmt.Sprintf("/voucher/%d", v.IDVoucher) }
                hx-target="closest tr"
                hx-swap="outerHTML"
            >
                Cancelar
            </button>
        </td>
    </tr>
}


templ FilasVouchers(vouchers []sqlc.GetVouchersRow){
    for _, v := range vouchers {
        @FilaVoucher(v)
    }
}

templ TablaVouchers(vouchers []sqlc.GetVouchersRow) {
	@Tabla("tablaVouchers", "cuerpoTablaVoucher", columnasVouchers) {
		for _, v := range vouchers {
			@FilaVoucher(v)
		}
	}
}

templ Vouchers(vouchers []sqlc.GetVouchersRow) {
	@Seccion("vouchers", "Vouchers","Mostrar vouchers","/vouchers-filas","cuerpoTablaVoucher") {
		@Bloque("Crear Voucher", formCrearVoucher)
		@Bloque("Buscar Voucher", formBuscarVoucher)
		@TablaVouchers(vouchers)
	}
}
