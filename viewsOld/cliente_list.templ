package views

import sqlc "TPE/db/sqlc"

templ ClienteList(clientes []sqlc.Cliente) {
    <h3>Listado de clientes</h3>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Deuda</th>
                <th>Teléfono</th>
            </tr>
        </thead>

        <tbody>
            for _, cliente := range clientes {
                <tr>
                    <td>{cliente.ID}</td>
                    <td>{cliente.Nombre}</td>
                    <td>{cliente.Apellido}</td>
                    <td>{cliente.Deuda}</td>
                    <td>{cliente.NroTelefono}</td>
                </tr>
            }
        </tbody>
    </table>
}