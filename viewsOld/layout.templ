package views

templ Layout(title string, errMsg string) {
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{ title }</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
</head>
<body>
<main class="container">
<h1>{ title }</h1>
if errMsg != "" {
<article role="alert"><strong>No se pudo completar la acción:</strong> { errMsg }</article>
}
{ children... }
</main>
</body>
</html>
}